# Copy to deploy/.env and replace every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
AGENTGUARD_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
AGENTGUARD_SERVICE_TOKEN=change-me
AGENTGUARD_PUBLIC_URL=http://localhost:8000
AGENTGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGENTGUARD_BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars
# Optional: an ingest-scoped API key created in the dashboard, used by the gateways to ship events.
AGENTGUARD_GATEWAY_API_KEY=
# Optional: directory containing injection-classifier-v1/ (built with `python ml/train.py`).
AGENTGUARD_MODEL_HOST_DIR=./models
WITH_EE=0
